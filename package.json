{
  "name": "backend-user-management",
  "version": "1.0.0",
  "description": "Backend User Management System with Express.js and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts && set NODE_ENV=development",
    "prod": "bun run src/index.ts && set NODE_ENV=production",
    "dev:ts": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["express", "typescript", "user-management", "api"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.18.2"
  }
}
